# Local — solo `VITE_*` se expone al cliente (Vite)
VITE_ENVIRONMENT=Local
VITE_BASE_URL=https://dev-tokener.blumon-engineering.com
VITE_API_URL_LOGIN=oauth/token
VITE_API_URL_LOGOUT=oauth/logout
# Credenciales del cliente OAuth (Basic Auth en /oauth/token y recomendado en /oauth/logout).
VITE_OAUTH_CLIENT_ID=blumon_pay_manager
VITE_OAUTH_CLIENT_SECRET=blumon_pay_manager_password
